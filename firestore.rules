rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 需求調查填報（實名制、無登入）：開放讀取以顯示排行榜，
    // 寫入加上形狀與長度驗證，避免被灌大量垃圾資料。
    match /submissions/{id} {
      allow read: if true;
      allow create, update: if isValidSubmission(request.resource.data);
      allow delete: if false;
    }

    // 前台填報開關（承辦人於後台手動切換「開放／已截止」）：
    // 公開讀取（前台每次載入判斷是否已截止），寫入限定欄位形狀與長度。
    match /config/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['frozen','message','updatedAt'])
        && request.resource.data.frozen is bool
        && request.resource.data.message is string && request.resource.data.message.size() <= 200
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    function isValidSubmission(d) {
      return d.keys().hasOnly(['name','role','classes','ts','tonggou','picks'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.role is string && d.role.size() <= 12
        && d.classes is list && d.classes.size() <= 40
        && d.ts is string
        && d.picks is list && d.picks.size() <= 60
        && d.tonggou is map;
    }

    // 其餘一律禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
